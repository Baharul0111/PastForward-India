# PastForward India — environment
#
# Copy this file to `.env.local` and fill in your own key:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored and must NEVER be committed.

# ---------------------------------------------------------------
# 1. REQUIRED — your OpenAI API key
#    Create one at https://platform.openai.com/api-keys
#    Your account needs access to the models listed in config/models.ts.
# ---------------------------------------------------------------
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ---------------------------------------------------------------
# 2. Media guardrails
#
#    Both false  → the whole pipeline runs against bundled fixtures and
#                  spends $0. Useful for development and for a first run.
#    Both true   → real images, real video, real narration. Costs money.
# ---------------------------------------------------------------
ALLOW_MEDIA=false
ALLOW_SORA=false

# ---------------------------------------------------------------
# 3. Budget guardrails (USD)
#
#    Every paid call checks the running total against BUDGET_HARD_STOP
#    BEFORE spending, and throws rather than exceeding it. The ledger
#    lives in cache/budget.json.
# ---------------------------------------------------------------
BUDGET_HARD_STOP=25
BUDGET_TARGET=12

# ---------------------------------------------------------------
# 4. Android only — the LAN address of the machine running this server.
#    Leave EMPTY for web. See README "Running on Android".
# ---------------------------------------------------------------
# NEXT_PUBLIC_API_BASE=http://192.168.1.100:3000
